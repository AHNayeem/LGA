# Copy to .env.local and fill in. Never commit real values.

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="lga"

# Public base URL of the app (used for origin checks and absolute links)
APP_URL="http://localhost:3000"

# Session lifetime in days
SESSION_TTL_DAYS=14

# Learner uploads/recordings storage: gridfs (Atlas) | memory (tests only)
MEDIA_STORAGE_DRIVER="gridfs"
# Speaking recordings: max upload size (2 MB; stays below Vercel's 4.5 MB request limit)
# and max recording length in seconds.
MEDIA_MAX_UPLOAD_BYTES=2097152
RECORDING_MAX_SECONDS=60

LOG_LEVEL="info"

# Used only by `bun run create-admin`
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# --- Offline audio generation only (`bun run audio:smoke` / `audio:generate`) -----------
# Never set these on Vercel: the app itself never calls a TTS API.
# Restrict the key to the Cloud Text-to-Speech API in the Google Cloud console.
# TTS_PROVIDER="google"
# GOOGLE_TTS_API_KEY=""
# Optional voice overrides. Defaults (checked against Google's de-DE list, 2026-09-27):
# TTS_VOICE_FEMALE="de-DE-Neural2-F"
# TTS_VOICE_MALE="de-DE-Neural2-E"
# TTS_VOICE_FEMALE2="de-DE-Neural2-C"
# TTS_VOICE_MALE2="de-DE-Wavenet-E"

# --- Atlas validation only (`bun run test:atlas`, `bun run test:e2e:atlas`) -------------
# A DEVELOPMENT/TEST cluster. Tests create and drop throwaway lga_itest_*/lga_e2e_*
# databases. Falls back to MONGODB_URI above; never to an in-memory database.
# ATLAS_TEST_URI=""
