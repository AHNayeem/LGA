# Copy to .env.local and fill in. Never commit real values.

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="lga"

# Public base URL of the app (used for origin checks and absolute links)
APP_URL="http://localhost:3000"

# Session lifetime in days
SESSION_TTL_DAYS=14

# Learner uploads/recordings storage: gridfs (Atlas) | memory (tests only)
MEDIA_STORAGE_DRIVER="gridfs"
MEDIA_MAX_UPLOAD_BYTES=5242880

LOG_LEVEL="info"

# Used only by `bun run create-admin`
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
