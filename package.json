{
  "name": "lga",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:atlas": "node --import ./scripts/register.mjs scripts/atlas-test.mjs",
    "test:e2e:atlas": "node --import ./scripts/register.mjs scripts/atlas-e2e.mjs",
    "db:indexes": "node --import ./scripts/register.mjs scripts/ensure-indexes.mjs",
    "seed": "node --import ./scripts/register.mjs scripts/seed.mjs",
    "audio:generate": "node --import ./scripts/register.mjs scripts/generate-audio.mjs",
    "audio:smoke": "node --import ./scripts/register.mjs scripts/tts-smoke.mjs",
    "audio:verify": "node --import ./scripts/register.mjs scripts/verify-audio.mjs",
    "create-admin": "node --import ./scripts/register.mjs scripts/create-admin.mjs",
    "content:check": "node --import ./scripts/register.mjs scripts/content-check.mjs",
    "content:fixture-publish": "node --import ./scripts/register.mjs scripts/fixture-publish.mjs",
    "media:cleanup": "node --import ./scripts/register.mjs scripts/cleanup-recordings.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "mongodb": "^7.6.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4",
    "vitest": "^5.0.2"
  }
}
